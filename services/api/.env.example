# Copy to .env for local development.
NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
CONTROL_DB=fahan_control
# 32 random bytes, base64. Encrypts MFA secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_KEY=
SESSION_TTL_HOURS=12
# Video service for telemedicine rooms. Use your own hosted instance in production.
TELE_BASE_URL=https://meet.jit.si
